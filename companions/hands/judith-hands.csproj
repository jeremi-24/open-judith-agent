<Project Sdk="Microsoft.NET.Sdk">
  <!-- Judith's hands, for agent mode (autonomous) only: clicks, typing, keys
       and scrolling through Windows SendInput. It decides nothing: every
       action is checked first by src/core/guard.js.
       Build: dotnet build companions/hands -c Release
       Output: companions/hands/bin/Release/net48/judith-hands.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>judith-hands</AssemblyName>
    <RootNamespace>JudithHands</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
